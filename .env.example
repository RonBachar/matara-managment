# ---- Server (Vercel env vars in production; .env locally) ----

# Neon (Vercel Storage). In Vercel these two are injected automatically when the
# database is connected to the project. Locally, copy them from the database's
# ".env.local" tab in Vercel → Storage.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"

# Firebase UID of the only user allowed in. Every other Google account gets 403.
MATARA_OWNER_USER_ID=your-firebase-uid

# Shared secret for POST /api/webhooks/leads (header: X-Matara-Webhook-Secret)
MATARA_WEBHOOK_SECRET=change-me-to-a-random-32-char-string

# Firebase Admin credentials as one-line JSON. Locally you can instead drop
# firebase-service-account.json in the repo root.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# ---- Client (Vite; must be prefixed VITE_; goes in .env.local locally) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
