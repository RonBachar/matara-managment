generator client {
  provider = "prisma-client-js"
}

// Variable names match what the Vercel↔Neon integration injects automatically.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  clientName   String
  /// Shown on the client's own page, not in the list.
  businessName String  @default("")
  phone        String  @default("")
  email        String  @default("")
  website      String?
  notes        String? @db.Text

  /// Carried over from the lead this client was converted from, so the list
  /// can still say what they asked for and which page brought them in.
  serviceType String @default("")
  leadSource  String @default("")

  /// The recurring package: hosting, an Elementor licence, or both. One per
  /// client, with a single renewal date — see PACKAGE_TYPE_OPTIONS.
  packageType        String?
  renewalPrice       Decimal?  @db.Decimal(14, 2)
  renewalDate        DateTime?
  reminderDaysBefore Int?

  /// Signed work agreement. A link today, uploaded or produced by the
  /// quote system later; either way it is one address.
  contractUrl String?

  projects Project[]

  @@index([userId])
  @@index([clientName])
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  projectName String
  status      String  @default("התחיל")
  totalAmount Decimal @default(0) @db.Decimal(14, 2)
  paidAmount  Decimal @default(0) @db.Decimal(14, 2)
  notes       String? @db.Text

  @@index([userId])
  @@index([clientId])
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  title       String
  description String? @db.Text
  status      String  @default("לביצוע")
  priority    String  @default("בינונית")

  @@index([userId])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String

  clientName String
  phone      String  @default("")
  email      String?
  leadSource String  @default("")
  status     String  @default("חדש")
  notes      String? @db.Text

  /// Which service the visitor asked about ("אתר תדמית", …). Empty when unknown.
  serviceType String @default("")

  /// Last 9 phone digits, used to recognise a repeat enquiry from the same
  /// person regardless of how the number was written (05…, 972…, spaces).
  phoneKey String?
  /// Lowercased email, same purpose as phoneKey when there is no phone.
  emailKey String?
  /// How many times this person has submitted a form. 1 on first contact.
  submissionCount Int @default(1)

  /// Set once the lead is turned into a client. The lead is kept either way,
  /// so a client can always be traced back to where they came from.
  convertedClientId String?
  convertedAt       DateTime?

  @@index([userId])
  @@index([userId, phoneKey])
  @@index([userId, emailKey])
}
